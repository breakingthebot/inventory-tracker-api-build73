# Environment Variables Template for Inventory Tracker API (Build 73)
# Copy to .env.local for local overrides. Never commit secrets to version control.

# Runtime Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
# Set UseInMemoryDatabase=true for zero-dependency in-memory execution
UseInMemoryDatabase=true

# SQL Server Connection String (Required when UseInMemoryDatabase=false)
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=InventoryTrackerDb;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;

# Logging Level (Trace | Debug | Information | Warning | Error | Critical)
Logging__LogLevel__Default=Information
